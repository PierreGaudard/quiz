# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# base D1 locale de wrangler dev
.wrangler/state/

# worktrees Claude Code : des clones du depot, jamais a versionner
.claude/worktrees/

# captures et snapshots playwright-cli : des artefacts de debug
.playwright-cli/

# Impeccable (detecteur de motifs d'interface generee) : installe en local
# par `npx impeccable install --yes --project --providers=claude`, binaire
# de 14 Mo qui n'a rien a faire dans le depot. Le hook dans
# .claude/settings.local.json ne fait rien tant qu'il est absent.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md

# variables locales de wrangler (ADMIN_BYPASS pour le back office en local)
.dev.vars
