---
/**
 * La page d'un mini-jeu (en).
 *
 * Une route par jeu, generee depuis le catalogue : un jeu ajoute dans
 * src/data/games apparait ici, dans le hub, dans les sitemaps et dans le
 * hreflang sans qu'on touche a une page.
 */
import Layout from "../../layouts/Layout.astro";
import GamePageBody from "../../components/GamePageBody.astro";
import { miniGameDefs, resolveGame, getGamesHubPath, getHreflangGamePaths } from "../../data/games";
import { buildGameStructuredData } from "../../lib/structured-data";
import { t } from "../../i18n/ui";
import type { Locale } from "../../i18n/config";

const locale: Locale = "en";

export function getStaticPaths() {
  return miniGameDefs.map((def) => ({ params: { game: def.slugs["en"] }, props: { id: def.id } }));
}

const { id } = Astro.props as { id: string };
const def = miniGameDefs.find((d) => d.id === id)!;
const game = resolveGame(def, locale);

const siteRoot = Astro.site?.toString().replace(/\/$/, "") || "";
const hubName = t(locale, "games.hubName");
const jsonLd = buildGameStructuredData({
  name: game.name,
  description: game.metaDescription,
  locale,
  siteUrl: siteRoot,
  pageUrl: `${siteRoot}${game.path}`,
  hubUrl: `${siteRoot}${getGamesHubPath(locale)}`,
  hubName,
  faq: game.faq,
});
---

<Layout
  title={game.metaTitle}
  description={game.metaDescription}
  ogImage={game.coverImage}
  locale={locale}
  hreflangPaths={getHreflangGamePaths(game.id)}
>
  <GamePageBody game={game} locale={locale} hubName={hubName} />
  {jsonLd.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))}
</Layout>
