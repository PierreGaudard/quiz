---
import { withBase } from "../../utils/base";
import Layout from "../../layouts/Layout.astro";
import { getHreflangStaticPaths } from "../../lib/hreflang-helpers";
import { localePath } from "../../utils/base";
import { t } from "../../i18n/ui";
import type { Locale } from "../../i18n/config";

const locale: Locale = "fr";
const lp = (path: string) => localePath(path, locale);
---

<Layout title={t(locale, "auth.loginTitle")} description={t(locale, "auth.loginDescription")} locale={locale} hreflangPaths={getHreflangStaticPaths("login")}>
  <main class="min-h-[calc(100vh-160px)] bg-ink flex items-center justify-center py-16 px-4 relative overflow-hidden">

    <div class="relative w-full max-w-md">
      <!-- Logo / Heading -->
      <div class="text-center mb-8">
        <a href={lp("/")} class="inline-block">
          <img src={withBase("/logo.webp")} alt="WizyQuiz" width="359" height="120" class="h-12 w-auto mx-auto" />
        </a>
        <h1 class="font-display text-2xl font-bold text-white mt-4">{t(locale, "auth.login")}</h1>
        <p class="text-white/50 text-sm mt-2">{t(locale, "auth.loginDescription")}</p>
      </div>

      <!-- Card -->
      <div class="bg-white rounded-2xl shadow-md p-8">
        <div id="auth-error" style="display:none" class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700 font-medium"></div>
        <form id="login-form" class="space-y-5">
          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">{t(locale, "auth.email")}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full h-11 px-4 rounded-lg border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
              placeholder="vous@exemple.com"
            />
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5">{t(locale, "auth.password")}</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full h-11 px-4 rounded-lg border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all"
              placeholder="********"
            />
            <p class="mt-2 text-right"><a href="/fr/mot-de-passe-oublie/" class="text-xs font-semibold text-brand-700 hover:underline">Mot de passe oublié ?</a></p>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full h-11 bg-sun hover:bg-sun-dark text-ink font-bold text-sm rounded-lg transition-colors"
          >
            {t(locale, "auth.loginCta")}
          </button>
        </form>

        <!-- Divider -->
        <div class="my-6 border-t border-gray-100"></div>

        <!-- Link to signup -->
        <p class="text-center text-sm text-gray-500">
          {t(locale, "auth.noAccount")}{" "}
          <a href={lp("/inscription")} class="font-bold text-brand-600 hover:text-brand-800 transition-colors">
            {t(locale, "auth.signup")}
          </a>
        </p>
      </div>
    </div>
  </main>
  <script is:inline>
          var ERR_MSG = {"An account already exists with this email": "Un compte existe déjà avec cette adresse e-mail.", "Database not available": "Le service est indisponible pour le moment. Réessayez dans un instant.", "Invalid credentials": "Adresse e-mail ou mot de passe incorrect.", "Missing fields": "Remplissez tous les champs.", "Password must be at least 6 characters": "Le mot de passe doit faire au moins 6 caractères.", "This username is already taken": "Ce nom d'utilisateur est déjà pris.", "Username can only contain letters, numbers and underscores": "Le nom d'utilisateur ne peut contenir que des lettres, des chiffres et des tirets bas.", "Username must be 3-30 characters": "Le nom d'utilisateur doit faire entre 3 et 30 caractères."};
document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('login-form');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var errEl = document.getElementById('auth-error');
        var btn = form.querySelector('button[type="submit"]');
        errEl.style.display = 'none';
        var email = document.getElementById('email').value.trim();
        var password = document.getElementById('password').value;
        btn.disabled = true; var orig = btn.textContent; btn.textContent = '...';
        fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email, password: password }) })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(r) { if (!r.ok) { errEl.textContent = (ERR_MSG[r.data.error] || r.data.error) || 'Identifiants incorrects'; errEl.style.display = 'block'; btn.disabled = false; btn.textContent = orig; return; } window.location.href = '/fr/'; })
        .catch(function() { errEl.textContent = 'Erreur reseau'; errEl.style.display = 'block'; btn.disabled = false; btn.textContent = orig; });
      });
    });
  </script>
</Layout>
