---
import Layout from "../../layouts/Layout.astro";
import PasswordResetForm from "../../components/PasswordResetForm";
import { getHreflangStaticPaths } from "../../lib/hreflang-helpers";
import type { Locale } from "../../i18n/config";

// Hors index meme apres l'ouverture : page de service, sans contenu.
const locale: Locale = "fr";
---

<Layout title={'Choisir un nouveau mot de passe | WizyQuiz'} description={'Choisissez un nouveau mot de passe pour votre compte WizyQuiz avec le lien reçu par e-mail. Le lien marche une heure.'} locale={locale} hreflangPaths={getHreflangStaticPaths("resetPassword")} noindex={true}>
  <main class="min-h-[calc(100vh-160px)] bg-ink flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="font-display text-2xl font-bold text-white">Choisir un nouveau mot de passe</h1>
        <p class="text-white/75 text-sm mt-2">Au moins 6 caractères. Une fois enregistré, vous êtes déconnecté de tous vos appareils.</p>
      </div>
      <div class="bg-white rounded-2xl p-8">
        <PasswordResetForm client:load mode="reset" locale={locale} />
      </div>
    </div>
  </main>
</Layout>
