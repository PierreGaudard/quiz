---
import Layout from "../layouts/Layout.astro";
import { MiniQCM, MiniVraiFaux, MiniEstimation } from "../components/MiniQuizzes";
import DailyQuestion from "../components/DailyQuestion";
import { getAllQuizzes } from "../data/quizzes";
import { getCategories, getGameTypes } from "../data/categories";
import { categoryIcons, gameTypeIcons } from "../data/icons";
import { localePath, withBase } from "../utils/base";
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/config";

const locale: Locale = "en";
const lp = (path: string) => localePath(path, locale);
const categories = getCategories(locale);
const gameTypesData = getGameTypes(locale);
const allQuizzes = getAllQuizzes(locale);

const mainCategories = categories;
const homepageCategories = categories;

const popularQuizzes = [...allQuizzes].sort((a, b) => (b.playCount || 0) - (a.playCount || 0));
const newestQuizzes = [...allQuizzes].slice(-4).reverse();
const totalPlays = allQuizzes.reduce((sum, q) => sum + (q.playCount || 0), 0);
// Compte reel des questions. C'etait `allQuizzes.length * 40`, soit 200
// questions annoncees pour 71 reelles, et le meme calcul servait a afficher
// « 200+ quiz disponibles » alors qu'il y en a 5.
const totalQuestions = allQuizzes.reduce((sum, q) => sum + q.questions.length, 0);

const qdjQuiz = allQuizzes[0];
const qdj = qdjQuiz?.questions[0];
const qdjImage = qdj?.image || qdjQuiz?.coverImage;

const DIFFICULTY_STYLE: Record<string, string> = {
  "Easy": "text-green-700 bg-green-100",
  "Medium": "text-amber-700 bg-amber-100",
  "Hard": "text-red-700 bg-red-100",
  "Facile": "text-green-700 bg-green-100",
  "Moyen": "text-amber-700 bg-amber-100",
  "Difficile": "text-red-700 bg-red-100",
  "Fácil": "text-green-700 bg-green-100",
  "Medio": "text-amber-700 bg-amber-100",
  "Difícil": "text-red-700 bg-red-100",
};
const GAME_TYPE_LABELS: Record<string, string> = {
  "qcm": "MCQ", "vrai-faux": "True/False", "chrono": "Chrono",
  "estimation": "Estimation", "duel": "Duel", "ordre": "Order",
};

function formatCount(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
  return n.toString();
}
---

<Layout title="Wizyquizz - Free trivia quizzes on every topic" locale={locale}>
  <main>

    {/* ===== HERO — texte à gauche + Question du Jour à droite ===== */}
    <section class="hero-gradient pt-10 pb-16 relative overflow-hidden">
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 28px 28px;"></div>
      <div aria-hidden="true" class="hero-blob hero-blob-yellow"></div>
      <div aria-hidden="true" class="hero-blob hero-blob-violet"></div>
      <img aria-hidden="true" src={withBase('/logo-mark.png')} alt="" width="130" height="120" class="hero-mark hidden lg:block" loading="lazy" />
      <div class="relative max-w-5xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_370px] gap-5 items-center">
          {/* Left */}
          <div class="space-y-5">
            <p class="inline-flex items-center gap-2 bg-yellow-400/10 border border-yellow-400/30 text-yellow-300 font-bold text-xs uppercase tracking-[0.15em] px-3 py-1.5 rounded-full"><span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>Free &middot; No sign-up &middot; An explanation every time</p>
            <h1 class="font-display text-5xl md:text-[4rem] font-bold text-white leading-[1.05] tracking-tight">
              The #1 platform<br/><span class="text-yellow-400">for trivia quizzes</span>
            </h1>
            <p class="text-white/70 text-base md:text-lg max-w-lg leading-relaxed">
              Play trivia quizzes on every topic: {totalQuestions} questions written by experts, and an explanation with every answer. Free, no sign-up required.
            </p>
            <div class="max-w-sm">
              <div class="relative">
                <input type="text" placeholder="NFL, Harry Potter, US States..." class="w-full h-12 pl-5 pr-14 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/40 text-sm focus:outline-none focus:bg-white/15 focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/20 transition-all" />
                <button class="absolute right-1.5 top-1.5 h-9 w-11 rounded-full bg-yellow-400 hover:bg-yellow-300 flex items-center justify-center transition-colors" aria-label="Search">
                  <svg class="w-4 h-4 text-[#1a0e42]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2.5}><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </button>
              </div>
            </div>
          </div>

          {/* Right: Question du Jour */}
          <div class="bg-white rounded-3xl p-5 shadow-2xl shadow-black/30 ring-1 ring-white/10 qotd-card">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-8 h-8 bg-violet-100 rounded-lg flex items-center justify-center text-violet-600 p-1.5">
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-full"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
              </span>
              <div>
                <p class="font-display font-bold text-sm text-gray-900">Question of the Day</p>
                <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wide">March 18, 2026</p>
              </div>
              <span class="ml-auto text-[10px] font-bold bg-violet-100 text-violet-600 px-2 py-0.5 rounded-full">Daily</span>
            </div>
            {qdj && (
              <DailyQuestion
                client:load
                question={qdj.question}
                answers={qdj.answers}
                correctAnswer={qdj.correctAnswer}
                explanation={qdj.explanation}
                image={qdjImage ? withBase(qdjImage) : undefined}
                locale="en"
              />
            )}
          </div>
        </div>
      </div>
    </section>

    {/* ===== QUIZ POPULAIRES — scroll ronds ===== */}
    <section class="bg-gradient-to-r from-[#2d1b69] to-[#1a0e42] py-5 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="font-display text-base font-bold text-yellow-400 mb-4">Popular Quizzes</h2>
        <div class="flex gap-5 overflow-x-auto pb-2 scrollbar-hide" style="scrollbar-width: none;">
          {popularQuizzes.slice(0, 10).map((quiz, i) => (
            <a href={lp(`/${quiz.path}`)} class="group shrink-0 flex flex-col items-center gap-2 w-[90px]">
              <div class="relative">
                <div class="w-[76px] h-[76px] rounded-full overflow-hidden border-[3px] border-yellow-400 group-hover:border-yellow-300 group-hover:shadow-yellow-400/40 transition-all shadow-lg">
                  {quiz.coverImage ? (
                    <img src={withBase(quiz.coverImage)} alt={quiz.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" width="800" height="450" loading="lazy" />
                  ) : (
                    <div class="w-full h-full bg-violet-600 flex items-center justify-center text-white font-bold text-lg">Q</div>
                  )}
                </div>
                {i < 3 && <span class="absolute -top-1 -right-1 w-5 h-5 bg-orange-700 rounded-full text-white text-[9px] font-black flex items-center justify-center border-2 border-[#2d1b69]">#{i+1}</span>}
              </div>
              <p class="text-[10px] text-white/60 group-hover:text-white font-semibold text-center leading-tight line-clamp-2 transition-colors">{quiz.title.replace(/^Quiz\s*/i, '').substring(0, 25)}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* placeholder — mini quizzes are dispersed below */}

    {/* ===== QUIZ À LA UNE — grand featured ===== */}
    <section class="max-w-6xl mx-auto px-4 pt-10 pb-6">
      {(() => {
        const featured = popularQuizzes[0];
        return featured && (
          <a href={lp(`/${featured.path}`)} class="group block relative rounded-3xl overflow-hidden aspect-[21/8] shadow-xl shadow-violet-900/10">
            {featured.coverImage && <img src={withBase(featured.coverImage)} alt={featured.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" width="800" height="450" loading="lazy" />}
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
            <div class="relative h-full flex flex-col justify-center p-8 md:p-12 max-w-lg">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-[10px] font-bold bg-orange-700 text-white px-2 py-0.5 rounded-full">Most played quiz</span>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${DIFFICULTY_STYLE[featured.difficulty]}`}>{featured.difficulty}</span>
                <span class="text-[10px] font-bold bg-white/20 text-white px-2 py-0.5 rounded-full backdrop-blur-sm">{GAME_TYPE_LABELS[featured.gameType] || "QCM"}</span>
              </div>
              <h2 class="font-display text-2xl md:text-3xl font-black text-white leading-tight mb-2">{featured.title}</h2>
              <p class="text-sm text-white/60 line-clamp-2 mb-4">{featured.description}</p>
              <div class="flex items-center gap-4 text-xs text-white/50">
                <span>{featured.questions.length} questions</span>
                {featured.playCount && <span class="font-bold text-yellow-400">{formatCount(featured.playCount)} plays</span>}
              </div>
            </div>
          </a>
        );
      })()}
    </section>

    {/* ===== GRILLE DE QUIZ — 4 colonnes, grandes images ===== */}
    <section class="max-w-6xl mx-auto px-4 pb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">Must-Play Quizzes</h2>
        <a href={lp('/')} class="text-xs font-bold text-violet-600 hover:text-violet-800 bg-violet-50 hover:bg-violet-100 px-3 py-1.5 rounded-full transition-colors">See all →</a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {popularQuizzes.slice(1, 9).map((quiz) => (
          <a href={lp(`/${quiz.path}`)} class="group relative rounded-2xl overflow-hidden aspect-[3/4] cursor-pointer card-lift">
            {quiz.coverImage && <img src={withBase(quiz.coverImage)} alt={quiz.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="800" height="450" loading="lazy" />}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            {/* Top badges */}
            <div class="absolute top-3 left-3 flex gap-1.5">
              <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${DIFFICULTY_STYLE[quiz.difficulty]}`}>{quiz.difficulty}</span>
            </div>
            <div class="absolute top-3 right-3">
              <span class="text-[10px] font-bold bg-black/40 text-white px-2 py-0.5 rounded-full backdrop-blur-sm">{GAME_TYPE_LABELS[quiz.gameType] || "QCM"}</span>
            </div>
            {/* Bottom content */}
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="font-display text-sm font-bold text-white leading-tight line-clamp-2 mb-1.5">{quiz.title}</h3>
              <div class="flex items-center justify-between text-[10px] text-white/50">
                <span>{quiz.questions.length} questions</span>
                {quiz.playCount && <span class="font-bold text-yellow-400">{formatCount(quiz.playCount)}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* ===== NOUVEAUX QUIZ — horizontal scroll ===== */}
    <section class="bg-gray-50 py-10">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 tracking-tight mb-6">Recently Added</h2>
        <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide" style="scrollbar-width: none;">
          {newestQuizzes.map((quiz, i) => (
            <a href={lp(`/${quiz.path}`)} class="group shrink-0 w-[240px] bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:-translate-y-1 transition-all duration-300">
              <div class="relative aspect-video overflow-hidden">
                {quiz.coverImage && <img src={withBase(quiz.coverImage)} alt={quiz.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="800" height="450" loading="lazy" />}
                <div class="absolute top-2 left-2">
                  <span class="text-[9px] font-bold bg-green-700 text-white px-2 py-0.5 rounded-full">New</span>
                </div>
              </div>
              <div class="p-3">
                <p class="text-[10px] font-bold text-violet-700 uppercase tracking-wide mb-0.5">{quiz.category}</p>
                <h3 class="text-sm font-bold text-gray-900 group-hover:text-violet-700 leading-tight line-clamp-2 transition-colors">{quiz.title}</h3>
                <p class="text-[10px] text-gray-400 mt-1">{['Mar 18', 'Mar 17', 'Mar 16', 'Mar 15'][i]} 2026 • {quiz.questions.length} questions</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ===== SEO + MINI QCM côte à côte ===== */}
    <section class="max-w-6xl mx-auto px-4 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-8 items-start">
        <div>
          <h2 class="font-display text-xl md:text-2xl font-bold text-gray-900 tracking-tight mb-3">We all know that friend who knows everything...</h2>
          <div class="text-sm text-gray-500 leading-relaxed space-y-3">
            <p>You know the type: the one dropping facts about the 1936 Olympics between two slices of pizza, the one who knows the capital of Bhutan. That friend probably plays a lot of quizzes, and that is where the idea for Wizyquizz came from.</p>
            <p>What we wanted was quizzes worth playing. A football question where you find out <a href={lp('/sports')} class="text-violet-600 font-semibold hover:underline">Pele scored more than a thousand goals</a>, or a flag you have been <a href={lp('/geography')} class="text-violet-600 font-semibold hover:underline">mixing up with its neighbour for years</a>.</p>
            <p>Every question comes with an explanation, so a question you get wrong is a question you learn from. You remember an answer you had to dig for better than one you read.</p>
          </div>
        </div>
        <div class="bg-violet-50 rounded-2xl p-5 border border-violet-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 bg-violet-500 rounded-lg flex items-center justify-center text-white text-xs font-bold">?</span>
            <p class="text-xs font-bold text-violet-700">Test yourself with a MCQ</p>
          </div>
          <MiniQCM locale="en" client:idle />
        </div>
      </div>
    </section>

    {/* ===== CATÉGORIES — grandes cartes portrait avec vraies images ===== */}
    <section class="max-w-6xl mx-auto px-4 py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">Explore by Category</h2>
        <a href={lp('/')} class="text-xs font-bold text-violet-600 hover:text-violet-800 bg-violet-50 hover:bg-violet-100 px-3 py-1.5 rounded-full transition-colors">All →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {homepageCategories.map((cat) => {
          const catQuizzes = allQuizzes.filter(q => q.category.toLowerCase() === cat.name.toLowerCase());
          const coverImg = cat.coverImage || catQuizzes.find(q => q.coverImage)?.coverImage;
          return (
            <a href={lp(`/${cat.slug}`)} class="group relative overflow-hidden rounded-2xl aspect-[3/4] card-lift">
              {coverImg ? (
                <img src={withBase(coverImg)} alt={cat.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" width="800" height="450" loading="lazy" />
              ) : (
                <div class={`absolute inset-0 ${cat.color}`}></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10 group-hover:from-black/70 transition-colors"></div>
              <div class="relative h-full flex flex-col justify-end p-4 text-white">
                <span class="w-8 h-8 mb-2 group-hover:scale-110 transition-transform origin-left text-white" set:html={categoryIcons[cat.slug] || cat.icon}></span>
                <h3 class="font-display font-bold text-lg leading-tight">{cat.name}</h3>
                <p class="text-xs text-white/60 mt-0.5">{catQuizzes.length} quiz</p>
                <div class="flex flex-wrap gap-1 mt-2">
                  {cat.subcategories.slice(0, 2).map((sub) => (
                    <span class="text-[9px] bg-white/15 backdrop-blur-sm px-1.5 py-0.5 rounded-full">{sub}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    {/* ===== 6 MODES DE JEU — strip horizontal clean ===== */}
    <section class="bg-[#1a0e42] py-10">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-8">
          <h2 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight mb-1">6 Ways to Play</h2>
          <p class="text-sm text-white/40">Not just multiple choice: discover unique game modes</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
          {gameTypesData.map((gt) => {
            const sampleQuiz = allQuizzes.find(q => q.gameType === gt.id);
            return (
              <div class="group relative overflow-hidden rounded-2xl aspect-[3/4] cursor-pointer card-lift">
                {sampleQuiz?.coverImage ? (
                  <img src={withBase(sampleQuiz.coverImage)} alt={gt.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" width="800" height="450" loading="lazy" />
                ) : (
                  <div class={`absolute inset-0 ${gt.color}`}></div>
                )}
                <div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-colors"></div>
                <div class="relative h-full flex flex-col items-center justify-center text-center p-4 text-white">
                  <span class="w-10 h-10 mb-3 group-hover:scale-110 transition-transform text-white" set:html={gameTypeIcons[gt.id] || gt.icon}></span>
                  <h3 class="font-display font-bold text-sm leading-tight mb-1">{gt.name}</h3>
                  <p class="text-[10px] text-white/50 leading-snug line-clamp-2">{gt.description.split('.')[0]}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ===== SEO + VRAI/FAUX côte à côte (inversé) ===== */}
    <section class="max-w-6xl mx-auto px-4 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-8 items-start">
        <div class="bg-emerald-50 rounded-2xl p-5 border border-emerald-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 bg-emerald-500 rounded-lg flex items-center justify-center text-white text-xs font-bold">V/F</span>
            <p class="text-xs font-bold text-emerald-700">True or False? You decide</p>
          </div>
          <MiniVraiFaux locale="en" client:idle />
        </div>
        <div>
          <h2 class="font-display text-xl md:text-2xl font-bold text-gray-900 tracking-tight mb-3">The quizzes everyone's playing right now</h2>
          <div class="text-sm text-gray-500 leading-relaxed space-y-3">
            <p>If you want one to start with, take the flags quiz: 17 questions, and after a couple of rounds you stop confusing the ones that look alike.</p>
            <p>The <a href={lp('/cinema')} class="text-violet-600 font-semibold hover:underline">eight Harry Potter films</a> make the longest quiz on the site, with 18 questions. Dragon Ball and Minecraft are shorter, ten questions each, and they are the two where fans get caught out the most.</p>
            <p>Fair warning on <a href={lp('/anime')} class="text-violet-600 font-semibold hover:underline">the Saiyan names</a>: the ones that look obvious are rarely the right answer.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ===== ESTIMATION — avec contexte et cadre visuel ===== */}
    <section class="max-w-6xl mx-auto px-4 pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-8 items-start">
        <div>
          <h2 class="font-display text-xl md:text-2xl font-bold text-gray-900 tracking-tight mb-3">The explanation under each answer</h2>
          <div class="text-sm text-gray-500 leading-relaxed space-y-3">
            <p>Every wrong answer here comes with the reason why. It is often the part people spend the longest reading.</p>
            <p>Estimation works differently: nothing to pick from, just a number to find. You give a number, we say higher or lower, and you narrow it down. The one on the right is playable, have a go. Same idea for <a href={lp('/video-games')} class="text-violet-600 font-semibold hover:underline">the rarer Minecraft mobs</a>.</p>
          </div>
        </div>
        <div class="bg-cyan-50 rounded-2xl p-5 border border-cyan-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-7 h-7 bg-cyan-500 rounded-lg flex items-center justify-center text-white text-xs font-bold">#</span>
            <p class="text-xs font-bold text-cyan-700">Higher or lower?</p>
          </div>
          <MiniEstimation locale="en" client:idle />
        </div>
      </div>
    </section>

    {/* ===== CTA CRÉER ===== */}
    <section class="max-w-6xl mx-auto px-4 py-12">
      <div class="relative overflow-hidden rounded-3xl hero-gradient p-8 md:p-14 text-center shadow-2xl shadow-violet-900/20">
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 24px 24px;"></div>
        <div aria-hidden="true" class="hero-blob hero-blob-yellow cta-blob"></div>
        <img aria-hidden="true" src={withBase('/logo-mark.png')} alt="" width="130" height="120" class="cta-mark" loading="lazy" />
        <div class="relative space-y-4">
          
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight">Got a quiz idea?</h2>
          <p class="text-white/70 text-base max-w-md mx-auto">Add your questions with their explanations, and share it with a link. It is free.</p>
          <a href={lp('/create')} class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-[#1a0e42] font-bold text-sm px-7 py-3.5 rounded-full transition-all shadow-lg shadow-yellow-400/30 hover:shadow-yellow-300/40 hover:-translate-y-0.5">Create my quiz →</a>
        </div>
      </div>
    </section>

    {/* ===== STATS INLINE — discret ===== */}
    <section class="max-w-6xl mx-auto px-4 py-6">
      <div class="flex items-center justify-center gap-6 text-center">
        <p class="text-sm text-gray-400"><span class="font-black text-violet-600">{allQuizzes.length}</span> quizzes available</p>
        <span class="text-gray-200">|</span>
        <p class="text-sm text-gray-400"><span class="font-black text-violet-600">{formatCount(totalPlays)}</span> games played</p>
      </div>
    </section>

    {/* ===== FAQ — accordéons stylisés, vraies questions SEO ===== */}
    <section class="bg-gray-50 py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8">
          <div class="lg:sticky lg:top-32">
            <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 tracking-tight mb-2">Frequently Asked Questions</h2>
            <p class="text-sm text-gray-400 leading-relaxed">Answers to the questions we get asked most about Wizyquizz.</p>
