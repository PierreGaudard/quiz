---
import Layout from "../layouts/Layout.astro";
import PasswordResetForm from "../components/PasswordResetForm";
import { getHreflangStaticPaths } from "../lib/hreflang-helpers";
import type { Locale } from "../i18n/config";

// Hors index meme apres l'ouverture : page de service, sans contenu.
const locale: Locale = "en";
---

<Layout title={'Choose a new password | WizyQuiz'} description={'Choose a new password for your WizyQuiz account with the link you received by e-mail. The link works for one hour.'} locale={locale} hreflangPaths={getHreflangStaticPaths("resetPassword")} noindex={true}>
  <main class="min-h-[calc(100vh-160px)] bg-ink flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="font-display text-2xl font-bold text-white">Choose a new password</h1>
        <p class="text-white/75 text-sm mt-2">Pick a password of at least 6 characters. Once it is saved, you will be logged out everywhere.</p>
      </div>
      <div class="bg-white rounded-2xl p-8">
        <PasswordResetForm client:load mode="reset" locale={locale} />
      </div>
    </div>
  </main>
</Layout>
