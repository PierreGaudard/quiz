---
/**
 * « Quiz de la communauté » : les quiz créés par des joueurs et acceptés dans
 * le back office (/admin/quiz/). Page rendue à la demande, hors index : ces
 * quiz ne sont pas relus avec la charte éditoriale du site.
 */
import type { Locale } from "../i18n/config";
import { localePath } from "../utils/base";
import { listApproved, type CommunityQuiz } from "../lib/moderation";

interface Props { locale: Locale }
const { locale } = Astro.props;
const lp = (p: string) => localePath(p, locale);

const T = {
  en: { h1: "Community quizzes", intro: "These quizzes were made by WizyQuiz players and read by the team before being opened to everyone. You can make your own in a few minutes.", create: "Create a quiz", by: "by", questions: "questions", plays: "plays", empty: "No community quiz yet. Yours could be the first!", play: "/create/play/", createPath: "/create/new/" },
  fr: { h1: "Quiz de la communauté", intro: "Ces quiz ont été créés par des joueurs de WizyQuiz et relus par l'équipe avant d'être ouverts à tous. Vous pouvez faire le vôtre en quelques minutes.", create: "Créer un quiz", by: "par", questions: "questions", plays: "parties", empty: "Pas encore de quiz de la communauté. Le vôtre peut être le premier !", play: "/creer/jouer/", createPath: "/creer/nouveau/" },
  es: { h1: "Quizzes de la comunidad", intro: "Estos quizzes los han creado jugadores de WizyQuiz y el equipo los ha revisado antes de abrirlos a todos. Puedes hacer el tuyo en unos minutos.", create: "Crear un quiz", by: "de", questions: "preguntas", plays: "partidas", empty: "Todavía no hay quizzes de la comunidad. ¡El tuyo puede ser el primero!", play: "/crear/jugar/", createPath: "/crear/nuevo/" },
}[locale];

let quizzes: CommunityQuiz[] = [];
try {
  const { env } = await import("cloudflare:workers");
  const db = (env as any).DB as D1Database | undefined;
  if (db) quizzes = await listApproved(db);
} catch {}
const nf = new Intl.NumberFormat(locale === "fr" ? "fr-FR" : locale === "es" ? "es-ES" : "en-US");
---

<main class="max-w-5xl mx-auto px-4 py-10">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <h1 class="font-display text-3xl font-bold text-gray-900">{T.h1}</h1>
      <p class="text-gray-600 mt-2">{T.intro}</p>
    </div>
    <a href={lp(T.createPath)} class="inline-flex items-center h-11 px-5 bg-sun text-ink font-bold text-sm rounded-lg">{T.create}</a>
  </div>

  {quizzes.length === 0 ? (
    <p class="text-gray-600 bg-white border border-gray-100 rounded-2xl p-6">{T.empty}</p>
  ) : (
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {quizzes.map((q) => (
        <li>
          <a href={`${lp(T.play)}?q=${q.slug}`} class="block h-full bg-white border border-gray-100 rounded-2xl p-5 hover:border-brand-300 transition-colors">
            {q.category && <p class="first-letter:uppercase text-xs font-semibold text-brand-700 mb-1">{q.category}</p>}
            <h2 class="font-display text-lg font-bold text-gray-900 leading-snug">{q.title}</h2>
            <p class="text-sm text-gray-500 mt-2">{T.by} {q.username} · {q.questions} {T.questions} · {nf.format(q.play_count)} {T.plays}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</main>
