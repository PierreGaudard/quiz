---
import { localePath, withBase } from "../utils/base";
import { getGamesHubPath } from "../data/games";
import { getCategories } from "../data/categories";
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/config";

interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const lp = (path: string) => localePath(path, locale);
/*
 * Pas d'alias `withBase = lp` ici.
 *
 * Il y en avait un, et il faisait passer le src du logo par localePath : le
 * pied de page demandait /fr/logo.png et /es/logo.png, qui n'existent pas.
 * Le fichier est servi a la racine, sans langue. L'appel avait l'air juste,
 * c'est ce qui l'a rendu invisible pendant tout ce temps. Un lien prend lp(),
 * une image prend withBase(), et les deux noms veulent dire ce qu'ils disent.
 */
const currentYear = new Date().getFullYear();

// Locale-aware slug mapping for static pages
const slugs: Record<string, Record<string, string>> = {
  create: { en: "/create", fr: "/creer", es: "/crear" },
  legal: { en: "/legal-notices", fr: "/mentions-legales", es: "/aviso-legal" },
  privacy: { en: "/privacy-policy", fr: "/confidentialite", es: "/politica-privacidad" },
  terms: { en: "/terms-of-use", fr: "/cgu", es: "/condiciones-uso" },
  sitemap: { en: "/sitemap", fr: "/plan-du-site", es: "/mapa-del-sitio" },
  cookies: { en: "/cookies", fr: "/cookies", es: "/cookies" },
};
const s = (key: string) => slugs[key]?.[locale] || slugs[key]?.en || key;

const sitemapCategories = getCategories(locale).filter((c) => c.subcategories.length > 0);
const categoriesLabel: Record<string, string> = { en: "Categories", fr: "Catégories", es: "Categorías" };

import { SOCIAL_LINKS } from "../config/social";
const SOCIAL_LABELS: Record<string, string> = { facebook: "Facebook", x: "X", instagram: "Instagram", youtube: "YouTube" };
const SOCIAL_ICONS: Record<string, string> = {
  facebook: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>`,
  x: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>`,
  instagram: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>`,
  youtube: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" /></svg>`,
};
const socials = Object.entries(SOCIAL_LINKS).filter(([n, h]) => h && SOCIAL_ICONS[n]) as [string, string][];
---

<footer class="bg-[#1a0e42] border-t border-white/5">
  {/* Main footer */}
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[1.3fr_1fr_1fr_1fr] gap-10 text-center md:text-left">
      {/* Col 1: Brand + description + socials */}
      <div class="flex flex-col items-center md:items-start">
        <a href={lp('/')} class="flex items-center mb-4" aria-label="WizyQuiz">
          <img src={withBase('/logo.webp')} alt="WizyQuiz" width="359" height="120" class="h-16 w-auto" />
        </a>
        <p class="text-sm text-white/50 leading-relaxed mb-5 max-w-xs">
          {t(locale, "footer.description")}
        </p>
        {socials.length > 0 && (
          <div class="flex items-center gap-2">
            {socials.map(([name, href]) => (
              <a href={href} rel="noopener" target="_blank" class="w-9 h-9 bg-white/10 hover:bg-white/20 rounded-lg flex items-center justify-center text-white/70 hover:text-white transition-colors" aria-label={SOCIAL_LABELS[name]} set:html={SOCIAL_ICONS[name]} />
            ))}
          </div>
        )}
      </div>

      {/* Col 2: Categories */}
      <div>
        <p class="font-display font-bold text-white text-sm mb-4">{categoriesLabel[locale] || categoriesLabel.en}</p>
        <ul class="space-y-2.5">
          {sitemapCategories.map((cat) => (
            <li><a href={lp(`/${cat.slug}`)} class="text-sm text-white/50 hover:text-white transition-colors">{cat.name}</a></li>
          ))}
        </ul>
      </div>

      {/* Col 3: Quiz & Games */}
      <div>
        <p class="font-display font-bold text-white text-sm mb-4">{t(locale, "footer.quizzesAndGames")}</p>
        <ul class="space-y-2.5">
          <li><a href={lp('/')} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.allQuizzes")}</a></li>
          <li><a href={lp(s('create'))} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.createQuiz")}</a></li>
          <li><a href={getGamesHubPath(locale)} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "games.hubName")}</a></li>
        </ul>
      </div>

      {/* Col 4: Information */}
      <div>
        <p class="font-display font-bold text-white text-sm mb-4">{t(locale, "footer.information")}</p>
        <ul class="space-y-2.5">
          <li><a href={lp(s('legal'))} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.legal")}</a></li>
          <li><a href={lp(s('privacy'))} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.privacy")}</a></li>
          <li><a href={lp(s('terms'))} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.terms")}</a></li>
          <li><a href={lp(s('cookies'))} class="text-sm text-white/50 hover:text-white transition-colors">Cookies</a></li>
          <li><a href="mailto:pierretartare94440@gmail.com" class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.contactUs")}</a></li>
          <li><a href={lp(s('sitemap'))} class="text-sm text-white/50 hover:text-white transition-colors">{t(locale, "footer.sitemap")}</a></li>
        </ul>
      </div>
    </div>
  </div>

  {/* Bottom bar */}
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col items-center gap-2 text-center">
      <div class="flex items-center gap-4 text-xs text-white/70">
        <a href={lp(s('legal'))} class="hover:text-white transition-colors">{t(locale, "footer.legal")}</a>
        <span class="text-white/10">|</span>
        <a href={lp(s('privacy'))} class="hover:text-white transition-colors">{t(locale, "footer.privacy")}</a>
        <span class="text-white/10">|</span>
        <a href={lp(s('terms'))} class="hover:text-white transition-colors">{t(locale, "footer.terms")}</a>
      </div>
      <p class="text-xs text-white/70">
        &copy; {currentYear} <span class="font-semibold text-white/50">WizyQuiz</span>. {t(locale, "footer.allRightsReserved")}
      </p>
    </div>
  </div>
</footer>
